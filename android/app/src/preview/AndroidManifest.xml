<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Bundled preview needs neither Metro network access nor a draw-over-apps grant. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" tools:node="remove" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove" />
    <application>
        <activity android:name="com.facebook.react.devsupport.DevSettingsActivity" tools:node="remove" />
    </application>
</manifest>
