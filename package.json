{
  "name": "attention-stats",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "react": "19.3.1",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@react-navigation/bottom-tabs": "7.21.0",
    "react-native-unistyles": "3.6.0",
    "react-native-reanimated": "4.7.1",
    "react-native-gesture-handler": "3.4.0",
    "@shopify/flash-list": "2.3.3",
    "react-native-svg": "15.16.0",
    "react-native-mmkv": "4.3.2",
    "zod": "4.6.7",
    "react-native-screens": "4.30.0",
    "react-native-worklets": "0.13.1",
    "react-native-nitro-modules": "0.37.1",
    "@react-native/normalize-colors": "0.88.0"
  },
  "devDependencies": {
    "@babel/runtime": "8.0.8",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "oxlint": "1.89.0",
    "@react-native/gradle-plugin": "0.88.0",
    "@react-native/codegen": "0.88.0"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start --host 127.0.0.1",
    "lint": "oxlint src index.js && python tools/check_architecture.py",
    "format:check": "prettier --check src index.js babel.config.js metro.config.js jest.config.js",
    "format": "prettier --write src index.js babel.config.js metro.config.js jest.config.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "check:mobile": "python tools/check_mobile.py",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output .cache/mobile/index.android.bundle --assets-dest .cache/mobile/assets --max-workers 2",
    "android:debug": "pnpm build",
    "android:release": "react-native build-android --tasks assembleRelease",
    "build": "react-native build-android --tasks assembleDebug"
  },
  "codegenConfig": {
    "name": "AttentionStatsSpec",
    "type": "modules",
    "jsSrcsDir": "src/platform/specs",
    "android": {
      "javaPackageName": "com.attentionstats.bridge"
    }
  }
}
