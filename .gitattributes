* text=auto eol=lf
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
LICENSE text eol=lf
*.bat text eol=crlf
*.jar binary
*.png binary
# Unified patches preserve a leading space on blank context lines.
*.patch whitespace=-blank-at-eol,-blank-at-eof
# Preserve the exact upstream license bytes, including its one trailing space.
licenses/libtomcrypt.txt whitespace=-blank-at-eol
